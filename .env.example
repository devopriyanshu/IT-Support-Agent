# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here        # optional, not used by default
GOOGLE_API_KEY=your_google_api_key_here        # required — get from https://aistudio.google.com

# External Search (Web Fallback)
TAVILY_API_KEY=your_tavily_api_key_here        # required — get from https://app.tavily.com

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here    # required — get from https://app.pinecone.io
PINECONE_INDEX_NAME=it-support-rag
PINECONE_NAMESPACE=company-it-kb

# LLM Models
GOOGLE_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Security
ADMIN_API_KEY=change-me-in-production          # used for /api/ingest and /api/documents endpoints

# Application Settings
APP_ENV=development                            # set to "production" in prod
